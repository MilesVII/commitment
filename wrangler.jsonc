/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "commitment",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-29",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "page",
		"binding": "ASSETS"
	}
}